# Copy to .env for local development (never commit .env).

# --- Supabase Postgres ---
# Pooled connection (Supavisor, port 6543, transaction mode) — app runtime queries.
DATABASE_URL=
# Direct connection (port 5432) — Prisma migrations only.
DIRECT_URL=

# --- Better Auth ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# --- Cloudflare R2 (Plan B — ID card storage; not required for Plan A) ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# --- Resend (Plan C — leads; not required for Plan A) ---
# RESEND_API_KEY=
