# Copy to .env for local development (never commit .env).

# --- SMTP (local Express + Netlify Functions) ---
SMTP_HOST=smtp.your-provider.com
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Optional From header; defaults to "Bubble Barrel" <SMTP_USER>
# MAIL_FROM=

# Recipient for contact form (required for sending). On Netlify:
# scope this to "Functions" only (not Build) — avoids secrets-scan noise vs client bundle.
# MAIL_TO=

# --- Public site (Vite / browser) ---
# Shown on the contact section. On Netlify: add to Build (and Preview) env.
# VITE_PUBLIC_CONTACT_EMAIL=

# Local dev: Vite dev server port (default 5173). Mail API proxy target:
# MAIL_API_PORT=3001

# Optional CORS for local Express
# CORS_ORIGIN=
